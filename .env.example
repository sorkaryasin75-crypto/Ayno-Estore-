# ==========================================
# AYNO ESTORE - ENVIRONMENT CONFIGURATION
# ==========================================

# Application
NODE_ENV=production
PORT=3000

# ==========================================
# PostgreSQL / Railway
# ==========================================

# Railway PostgreSQL থেকে পাওয়া DATABASE_URL
DATABASE_URL=postgresql://username:password@host:5432/database

# Optional PostgreSQL settings
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSL=true

# ==========================================
# Authentication
# ==========================================

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d

# ==========================================
# Frontend / Application URL
# ==========================================

APP_URL=https://your-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# ==========================================
# CORS
# ==========================================

CORS_ORIGIN=https://your-frontend-domain.com

# ==========================================
# Admin
# ==========================================

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# ==========================================
# Telegram
# ==========================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# ==========================================
# Payment - bKash
# ==========================================

BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=

# ==========================================
# Payment - Nagad
# ==========================================

NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
NAGAD_BASE_URL=

# ==========================================
# File / Upload
# ==========================================

MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# ==========================================
# Security
# ==========================================

SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET

# ==========================================
# Logging
# ==========================================

LOG_LEVEL=info
